{{!-- params: copy, primary, secondary (optional), image — homepage hero only (text+image, no anchor links) --}}
<section class="hero hero--home u-grid">
  <div class="hero__content u-grid-span-3">
    {{#get 'pages' filter=copy limit='1'}}
      {{#foreach pages}}
        {{content}}
      {{/foreach}}
    {{/get}}
    {{> "components/cta-buttons" primary=primary secondary=secondary}}
  </div>
  <div class="hero__image u-grid-span-4">
    {{#get 'pages' filter=image limit='1' include='feature_image'}}
      {{#foreach pages}}
        {{#if feature_image}}
          <figure>
            <img src="{{feature_image}}" alt="{{custom_excerpt}}" />
          </figure>
        {{/if}}
      {{/foreach}}
    {{/get}}
  </div>
</section>
