{{!-- params: copy, primary, secondary (optional): each a Ghost page title filter, e.g. "title:'About::Callout'" --}}
{{!-- label: short accessible name distinguishing this callout from others on the same page --}}
<aside class="cta" aria-label="{{label}}">
  <div class="cta__inner">
    {{#get 'pages' filter=copy limit='1'}}
      {{#foreach pages}}
        {{content}}
      {{/foreach}}
    {{/get}}
    <div class="cta__actions">
      <div class="cta__primary">
        {{#get 'pages' filter=primary limit='1'}}
          {{#foreach pages}}
            {{content}}
          {{/foreach}}
        {{/get}}
      </div>
      {{#if secondary}}
        <div class="cta__secondary">
          {{#get 'pages' filter=secondary limit='1'}}
            {{#foreach pages}}
              {{content}}
            {{/foreach}}
          {{/get}}
        </div>
      {{/if}}
    </div>
  </div>
</aside>
