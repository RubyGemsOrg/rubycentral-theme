{{!-- params: copy, primary, secondary (optional): each a Ghost page title filter, e.g. "title:'About::Callout'" --}}
{{!-- label: short accessible name distinguishing this callout from others on the same page --}}
<aside class="cta" aria-label="{{label}}">
  <div class="cta__inner">
    {{#get 'pages' filter=copy limit='1'}}
      {{#foreach pages}}
        {{content}}
      {{/foreach}}
    {{/get}}
    {{> "components/cta-buttons" primary=primary secondary=secondary}}
  </div>
</aside>
