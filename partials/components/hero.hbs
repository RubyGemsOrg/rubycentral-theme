{{!-- params: copy (required), links (optional, tag filter), linksLabel (required if links) --}}
<section class="hero u-grid">
  <div class="hero__content u-grid-span-5">
    {{#get 'pages' filter=copy limit='1'}}
      {{#foreach pages}}
        {{content}}
      {{/foreach}}
    {{/get}}
  </div>
  {{#if links}}
    <nav class="hero__links u-grid-span-2" aria-label="{{linksLabel}}">
      <p class="hero__links-label">{{linksLabel}}</p>
      <ul>
        {{#get 'pages' filter=links limit='8' order='published_at asc'}}
          {{#foreach pages}}
            <li>
              <a href="{{custom_excerpt}}">
                {{title}}
                {{> "icons/arrow"}}
              </a>
            </li>
          {{/foreach}}
        {{/get}}
      </ul>
    </nav>
  {{/if}}
</section>
