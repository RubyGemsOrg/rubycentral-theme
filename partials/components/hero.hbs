{{!-- params: copy (required), links (optional, tag filter), linksLabel (required if links) --}}
<section class="hero u-grid">
  <div class="hero__content u-grid-span-5">
    {{#get 'pages' filter=copy limit='1'}}
      {{#foreach pages}}
        {{content}}
      {{/foreach}}
    {{/get}}
  </div>
  {{#if links}}
    <div class="hero__links u-grid-span-2">
      {{> "components/link-list" links=links label=linksLabel}}
    </div>
  {{/if}}
</section>
