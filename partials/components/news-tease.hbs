<li class="news-teases__item">
  <a href="{{url}}">
    <h3 class="news-teases__title">{{title}}</h3>
  </a>
  <p class="news-teases__excerpt">{{excerpt words="25"}}</p>
  <p class="news-teases__date">Published on <date datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="MMMM D, YYYY"}}</date></p>
</li>
