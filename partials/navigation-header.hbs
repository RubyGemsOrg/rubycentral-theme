<header class="global-nav is-closed">
  <a href="/">{{> "logo"}}</a>
  <button
    type="button"
    class="global-nav__menu-toggle"
    aria-expanded="false"
    aria-controls="global-nav-menu"
    aria-label="Toggle navigation"
  >
  Menu
  </button>
  <nav id="global-nav-menu" class="global-nav__links" aria-label="Primary">
    <ul class="global-nav__list">
      {{#foreach navigation}}
        <li class="global-nav__item">
          <a class="global-nav__link" href="{{url absolute="true"}}">{{label}}</a>
        </li>
      {{/foreach}}
      <a href="#" class="button button--primary">Get involved</a>
    </ul>
  </nav>
</header>
