{{!< default}}

{{#post}}
<header class="post-header">
  <div class="post-header__inner u-container">
    <p class="post-header__date"><time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="MMMM D, YYYY"}}</time></p>
    <h1 class="post-header__title">{{title}}</h1>
  </div>
</header>
<article class="post u-container u-container--narrow">
  <div class="post__content">
    {{content}}
  </div>
</article>
{{/post}}

{{#contentFor 'scripts'}}
  <script src="{{asset 'dist/post.js'}}" defer></script>
{{/contentFor}}
